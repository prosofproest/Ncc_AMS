# Save this file as  .env.local  (next to package.json).  On Vercel, enter the same names/values under
# Settings → Environment Variables instead.  Verify with:  npm run check-env
#
# ─── FIREBASE (Firestore, Admin SDK) ───────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ─── CLOUDINARY (parade photos) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── SECURITY ──────────────────────────────────────────────────
# Both must be long random strings.  Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CRON_SECRET=
# Emergency use only: bypass OTP for admin accounts that do not have an email set
# ALLOW_ADMIN_WITHOUT_OTP=true

# ─── EMAIL (Gmail SMTP) ────────────────────────────────────────
# Gmail → Security → 2-Step Verification ON → App passwords → create one (16 letters)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=xxxxxxxxxxxxxxxx
# Optional first-time defaults for "Sir's email" and "Backup email".
# After the first start, change them any time in Admin → Settings (no redeploy needed).
EMAIL_TO=
EMAIL_CC=

# ─── GOOGLE SHEETS ─────────────────────────────────────────────
# Enable "Google Sheets API", create a Service Account + JSON key, SHARE the sheet with the
# service-account email as Editor, and copy the sheet id from the URL (…/d/<ID>/edit).
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# ─── APP ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Marker session lifetime in minutes (default: 30)
MARKER_SESSION_MINUTES=30
